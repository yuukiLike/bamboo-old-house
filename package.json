{
  "name": "bamboo-old-house",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.14.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "check": "pnpm typecheck && pnpm lint && pnpm test && node scripts/generate-bamboo-lod.mjs --check",
    "build:release": "pnpm check && pnpm build && node scripts/release.mjs prepare",
    "deploy:preview": "node scripts/release.mjs upload",
    "start": "vite preview",
    "lint": "oxlint",
    "format": "oxfmt",
    "preview": "vite preview",
    "perf": "node scripts/perf/run.mjs",
    "perf:report": "node scripts/perf/report.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "sync": "rsync -aim --exclude=.DS_Store ../blender-two/website/public/ public/ && pnpm build"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.31.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-server-dom-webpack": "19.2.6",
    "shadcn": "4.18.0",
    "tailwind-merge": "3.6.0",
    "three": "^0.185.1",
    "tw-animate-css": "1.4.0",
    "vinext": "1.0.0-beta.5"
  },
  "devDependencies": {
    "@openai/sites-vite-plugin": "0.2.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "meshoptimizer": "1.1.1",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vite": "8.0.13",
    "wrangler": "4.132.0"
  },
  "type": "module",
  "description": "An interactive 3D memory of an old house in a bamboo forest, built with Three.js."
}
